@startuml ME02_Evento_Funcion
' Actualizado 2026-11-26: alineado con BD v6.2. Estados financieros derivados (no columnas), PagoOrden/PagoArrendamiento, webhook_stripe, contingencia_funcion por tabla, cotizacion_version al aprobar, asignacion_butaca para el inventario.
hide empty description
skinparam state {
  BackgroundColor #F8FAFC
  BorderColor #1E293B
  ArrowColor #334155
}

state "Ciclo de Vida del EVENTO" as Ev {
  [*] --> PENDIENTE_PUBLICACION : Arrendamiento CONFIRMADO\no Evento Directo [Comercial / Público]
  [*] --> OPERACION_SIN_CARTELERA : Arrendamiento CONFIRMADO\no Evento Directo [modalidad Privado]

  PENDIENTE_PUBLICACION --> PUBLICADO : Póster (+ tarifas >= $100 si Comercial)\n+ aprobación final ADMIN\n[<= fecha_limite_publicacion]
  PENDIENTE_PUBLICACION --> VENCIDO_SIN_PUBLICAR : now() > min(inicio_1er_bloque,\nmax(1ra_fecha - 15d, fecha_pago + 3d))\n[Celery Beat]
  PENDIENTE_PUBLICACION --> CANCELADO_POR_ARRENDATARIO : Cancelación / incumple D-21
  PENDIENTE_PUBLICACION --> CANCELADO_POR_TEATRO : Cancelación Teatro / Directo

  VENCIDO_SIN_PUBLICAR --> PUBLICADO : Admin apoya (1) o concede\nprórroga (2) y aprueba
  VENCIDO_SIN_PUBLICAR --> OPERACION_SIN_CARTELERA : Admin autoriza operar\nsin venta web / cartelera (3)
  VENCIDO_SIN_PUBLICAR --> CANCELADO_POR_ARRENDATARIO : Admin cancela arrendamiento (4)
  VENCIDO_SIN_PUBLICAR --> CANCELADO_POR_TEATRO : Admin cancela Evento Directo (4)

  PUBLICADO --> CANCELADO_POR_ARRENDATARIO : Cancelación arrendatario / D-21
  PUBLICADO --> CANCELADO_POR_TEATRO : Cancelación Teatro
  PUBLICADO --> FINALIZADO : Todas sus funciones concluyen

  OPERACION_SIN_CARTELERA --> CANCELADO_POR_ARRENDATARIO : Cancelación arrendatario / D-21
  OPERACION_SIN_CARTELERA --> CANCELADO_POR_TEATRO : Cancelación Teatro
  OPERACION_SIN_CARTELERA --> FINALIZADO : Todas sus funciones concluyen
}

--

state "Ciclo Administrativo por FUNCIÓN" as Fn {
  [*] --> PROGRAMADA : Función creada dentro de BloqueoAgenda\n[inicio_en, fin_en en UTC; hora local derivada]

  PROGRAMADA --> REPROGRAMADO : Admin reprograma fecha/horario\n[operación atómica en AgendaService;\nregistra reprogramacion_funcion; Evento permanece PUBLICADO y QRs vigentes]
  PROGRAMADA --> CANCELADA : Evento cancelado
  REPROGRAMADO --> CANCELADA : Evento cancelado
  PROGRAMADA --> CONCLUIDA : now() > fin_en
  REPROGRAMADO --> CONCLUIDA : now() > fin_en

  note right of Fn
    Las ventanas operativas (solo Comercial en PUBLICADO) se evalúan
    determinísticamente en services.py sobre inicio_en / fin_en (UTC):
    * Venta web: now() < inicio_en - 30 min
    * Taquilla física: now() < inicio_en - 0 min
    * Acceso QR en puerta: inicio_en - 2h <= now() <= fin_en
    * Modo contingencia: tabla contingencia_funcion (una abierta por función; <= 24h antes)
  end note
}
@enduml
