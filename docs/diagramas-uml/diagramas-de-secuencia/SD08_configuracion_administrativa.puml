@startuml SD08_configuracion_administrativa
skinparam shadowing false
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 10
skinparam BoxPadding 8
hide footbox
autonumber
title SD08 · Configuración administrativa (casos de uso 08)

actor "Administrador" as A
box "Operación interna /gestion/" #FFFFFF
  boundary "AdminConfiguracionPage" as UI
end box
control "ConfiguracionService" as CFG_CTL
control "AuditoriaService" as AUD_CTL
entity "Turno" as E_TUR
entity "ServicioExtra" as E_EXT
entity "ConfiguracionSistema" as E_CFG
entity "RegistroAuditoria" as E_AUD

== UC1 · Administrar tarifas base y horarios de arrendamiento ==
A -> UI : Consulta turnos vigentes (MATUTINO, VESPERTINO, DIA_COMPLETO)
UI -> CFG_CTL ++ : GET /api/v1/configuracion/turnos/{turno}/
CFG_CTL -> E_TUR : leer horario y tarifa base
CFG_CTL --> UI -- : 200 {turno, hora_inicio, hora_fin, tarifa_base}

A -> UI : Actualiza horario o tarifa base
UI -> CFG_CTL ++ : PUT /api/v1/configuracion/turnos/{turno}/ {hora_inicio, hora_fin, tarifa_base}
alt [horario y tarifa válidos]
  CFG_CTL -> E_TUR : guardar actualización (aplica solo a cotizaciones futuras · snapshot)
  CFG_CTL -> AUD_CTL : auditar cambio de turno
  AUD_CTL -> E_AUD : insertar registro
  CFG_CTL --> UI : 200 {turno actualizado}
else [datos inválidos]
  CFG_CTL --> UI -- : 400 DATOS_INVALIDOS
end
UI --> A : Confirma actualización

== UC2 · Administrar catálogo de servicios extra e infraestructura ==
A -> UI : Crea o edita servicio extra / infraestructura
UI -> CFG_CTL ++ : POST /api/v1/configuracion/extras/ {nombre, tipo_concepto, precio_base, unidad_cobro, activo}
note right of CFG_CTL : unidad_cobro obligatoria:\nPOR_EVENTO, POR_DIA, POR_TURNO o POR_UNIDAD
CFG_CTL -> E_EXT : insertar o actualizar concepto (PATCH /configuracion/extras/{id}/)
CFG_CTL -> AUD_CTL : auditar modificación de catálogo
AUD_CTL -> E_AUD : insertar registro
CFG_CTL --> UI -- : 201 / 200 {extra}
UI --> A : Catálogo actualizado

== UC3, UC4 y UC5 · Configurar parámetros de compra, políticas y cotizaciones/agenda ==
A -> UI : Consulta parámetros operativos vigentes
UI -> CFG_CTL ++ : GET /api/v1/configuracion/parametros/
CFG_CTL -> E_CFG : leer parámetros vigentes
CFG_CTL --> UI -- : 200 {apartado_min, gracia_pago_min, cierre_web_min, cierre_taquilla_min, ...}

A -> UI : Modifica subconjunto de parámetros (UC3 compra/taquilla, UC4 políticas, UC5 agenda/cotizaciones)
UI -> CFG_CTL ++ : PATCH /api/v1/configuracion/parametros/ {subconjunto de claves}
CFG_CTL -> CFG_CTL : validar rangos y coherencia del conjunto resultante (ej. sla_atraso_dh > sla_respuesta_dh)
alt [conjunto resultante válido]
  CFG_CTL -> E_CFG : persistir parámetros (sin alterar cotizaciones ya congeladas · snapshot)
  CFG_CTL -> AUD_CTL : auditar cambio de configuración
  AUD_CTL -> E_AUD : insertar registro
  CFG_CTL --> UI : 200 {configuración resultante}
else [valores incoherentes o fuera de rango]
  CFG_CTL --> UI -- : 400 DATOS_INVALIDOS
end
UI --> A : Muestra configuración guardada
@enduml
