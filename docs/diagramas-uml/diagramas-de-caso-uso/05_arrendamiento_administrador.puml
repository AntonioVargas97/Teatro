@startuml 05_arrendamiento_administrador
skinparam shadowing false
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
skinparam ArrowColor #333333
left to right direction
actor "Administrador" as A

rectangle "Cotización y seguimiento de arrendamiento" {
  usecase "Consultar calendario de\ndisponibilidad" as UC1
  usecase "Gestionar solicitudes de\ncotización" as UC2
  usecase "Aprobar cotización" as UC3
  usecase "Rechazar solicitud de\ncotización" as UC4
  usecase "Proponer fechas\nalternativas" as UC5
  usecase "Resolver pago\nextemporáneo" as UC6
  usecase "Cancelar arrendamiento" as UC7
  usecase "Registrar bloqueos de agenda\nde mantenimiento" as UC8
  usecase "Liberar bloqueos de agenda\nde mantenimiento" as UC9
}

A --> UC1
A --> UC2
A --> UC6
A --> UC7
A --> UC8
A --> UC9

UC2 <.. UC3 : <<extend>>
UC2 <.. UC4 : <<extend>>
UC2 <.. UC5 : <<extend>>
@enduml
