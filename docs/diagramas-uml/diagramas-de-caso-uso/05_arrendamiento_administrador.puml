@startuml 05_arrendamiento_administrador
skinparam shadowing false
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
skinparam ArrowColor #333333
left to right direction
actor "Administrador" as A

rectangle "Cotización y seguimiento de arrendamiento" {
  usecase "Consultar calendario de\ndisponibilidad" as UC1
  usecase "Registrar bloqueos de\nagenda" as UC2
  usecase "Revisar solicitudes de\ncotización" as UC3
  usecase "Aprobar cotización" as UC4
  usecase "Rechazar solicitud de\ncotización" as UC5
  usecase "Proponer fechas\nalternativas" as UC6
  usecase "Realizar pago de\narrendamiento" as UC7
  usecase "Resolver pago\nextemporáneo" as UC8
}

A --> UC1
A --> UC2
A --> UC3
A --> UC7
A --> UC8
UC3 <.. UC4 : <<extend>>
UC3 <.. UC5 : <<extend>>
UC3 <.. UC6 : <<extend>>
@enduml
