@startuml 06_eventos_tarifas_y_publicacion
' Alineado con BD v6.2 y Contrato API v1
skinparam shadowing false
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
skinparam ArrowColor #333333
left to right direction
actor "Administrador" as A
actor "Usuario estándar" as U

rectangle "Gestión de eventos, tarifas y publicación" {
  usecase "Registrar evento directo" as UC1
  usecase "Consultar datos de evento" as UC2
  usecase "Editar datos de evento" as UC3
  usecase "Administrar funciones del\nevento" as UC4
  usecase "Reprogramar función de\nevento" as UC5
  usecase "Reprogramar evento" as UC6
  usecase "Cancelar evento" as UC7
  usecase "Publicar evento" as UC8
  usecase "Cargar / actualizar póster\npublicitario" as UC9
  usecase "Configurar secciones, secciones\nde evento y tarifas" as UC10
  usecase "Emitir cortesías" as UC11
  usecase "Revocar cortesías" as UC12
  usecase "Bloquear localidad por\nmotivos técnicos" as UC13
  usecase "Retirar bloqueo técnico" as UC14
}

A --> UC1
A --> UC2
A --> UC3
A --> UC4
A --> UC5
A --> UC6
A --> UC7
A --> UC8
A --> UC9
A --> UC10
A --> UC11
A --> UC12
A --> UC13
A --> UC14
U --> UC9
U --> UC10
@enduml
