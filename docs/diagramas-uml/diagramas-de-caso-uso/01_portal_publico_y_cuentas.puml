@startuml 01_portal_publico_y_cuentas
' Alineado con BD v6.2 y Contrato API v1
skinparam shadowing false
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
skinparam ArrowColor #333333
left to right direction
actor "Visitante" as V
actor "Usuario estándar" as U

rectangle "Portal público y gestión de cuentas" {
  usecase "Registrarse" as UC1
  usecase "Consultar aviso de privacidad\ny términos de servicio" as UC2
  usecase "Iniciar sesión" as UC3
  usecase "Cerrar sesión" as UC4
  usecase "Recuperar contraseña\npor correo" as UC5
  usecase "Confirmar restablecimiento\nde contraseña" as UC6
  usecase "Consultar cartelera" as UC7
  usecase "Filtrar cartelera por fecha\ny categoría" as UC8
  usecase "Consultar información de\nun evento" as UC9
  usecase "Consultar mapa de\ndisponibilidad de asientos" as UC10
  usecase "Gestionar perfil personal" as UC11
}

V --> UC1
V --> UC7
V --> UC9
V --> UC10
U --> UC3
U --> UC4
U --> UC5
U --> UC7
U --> UC9
U --> UC10
U --> UC11

UC1 ..> UC2 : <<include>>
UC5 ..> UC6 : <<include>>
UC7 <.. UC8 : <<extend>>
@enduml
