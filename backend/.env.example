# ==============================================================================
# Variables de entorno del Backend — Teatro de la Ciudad de Coatzacoalcos
# Copia este archivo a `backend/.env` para uso local (no subir `.env` a Git).
# ==============================================================================

# Django
DJANGO_SECRET_KEY=cambia-esta-clave-secreta-en-desarrollo-local
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
TIME_ZONE=America/Mexico_City

# PostgreSQL (en Docker Compose el host es `db`)
POSTGRES_DB=teatro_db
POSTGRES_USER=teatro
POSTGRES_PASSWORD=teatro_dev_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://teatro:teatro_dev_password@db:5432/teatro_db

# Redis (sesiones, caché, rate limiting y broker de Celery; en Docker el host es `redis`)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Medios (pósters de eventos)
MEDIA_ROOT=/app/media

# Correo transaccional SMTP (en desarrollo apunta a Mailpit)
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@teatrocoatzacoalcos.local

# Stripe Sandbox
STRIPE_PUBLIC_KEY=pk_test_reemplazar
STRIPE_SECRET_KEY=sk_test_reemplazar
STRIPE_WEBHOOK_SECRET=whsec_reemplazar

# Firma HMAC de boletos QR
QR_HMAC_SECRET=cambia-este-secreto-hmac-qr-local
